EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# HTTPS base route written to NFC tags. The app appends /<nfc_token>.
EXPO_PUBLIC_NFC_BASE_URL=https://your-domain.com/join
# Host without protocol, used to generate iOS Universal Links and Android App Links.
EXPO_PUBLIC_NFC_DOMAIN=your-domain.com
